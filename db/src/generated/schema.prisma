generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model RewrapKey {
  id              Int         @id @default(autoincrement())
  recordCid       String
  recipientPubkey String
  encryptedSymKey String      @db.Text
  creatorPubkey   String?
  createdAt       DateTime    @default(now())
  expiresAt       DateTime?
  accessCount     Int         @default(0)
  lastAccessedAt  DateTime?
  accessLogs      AccessLog[]

  @@unique([recordCid, recipientPubkey], name: "recordCid_recipientPubkey")
  @@index([recipientPubkey], name: "idx_recipient_pubkey")
  @@index([recordCid], name: "idx_record_cid")
  @@index([expiresAt], name: "idx_expires_at")
  @@map("rewrap_keys")
}

model AccessLog {
  id              Int        @id @default(autoincrement())
  recordCid       String
  recipientPubkey String
  rewrapKeyId     Int?
  success         Boolean
  ipAddress       String?
  userAgent       String?    @db.Text
  errorMessage    String?    @db.Text
  accessedAt      DateTime   @default(now())
  rewrapKey       RewrapKey? @relation(fields: [rewrapKeyId], references: [id])

  @@index([recordCid], name: "idx_access_record_cid")
  @@index([recipientPubkey], name: "idx_access_recipient")
  @@index([accessedAt], name: "idx_access_time")
  @@map("access_logs")
}

model Admin {
  id       Int      @id @default(autoincrement())
  pubkey   String   @unique
  addedBy  String?
  addedAt  DateTime @default(now())
  isActive Boolean  @default(true)

  @@index([pubkey])
  @@map("admins")
}

model ConsentCredential {
  id              Int       @id @default(autoincrement())
  consentCid      String    @unique
  recordCid       String
  issuerPubkey    String
  recipientPubkey String
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  anchoredTxId    String?

  @@index([issuerPubkey], name: "idx_issuer")
  @@index([recipientPubkey], name: "idx_recipient")
  @@index([recordCid], name: "idx_consent_record")
  @@map("consent_credentials")
}

model RecordAnchor {
  id          Int      @id @default(autoincrement())
  recordCid   String   @unique
  txSignature String
  pda         String
  anchoredBy  String
  anchoredAt  DateTime @default(now())

  @@map("record_anchors")
}

model AccessRequest {
  id              Int       @id @default(autoincrement())
  recordCid       String
  requesterPubkey String
  ownerPubkey     String
  purpose         String    @db.Text
  status          String    @default("pending")
  respondedAt     DateTime?
  responseNote    String?   @db.Text
  consentId       Int?
  createdAt       DateTime  @default(now())

  @@index([ownerPubkey])
  @@index([requesterPubkey])
  @@index([recordCid])
  @@map("access_requests")
}

model AuditEvent {
  id           Int      @id @default(autoincrement())
  action       String
  actorPubkey  String
  recordCid    String?
  targetPubkey String?
  metadata     String?  @db.Text
  ipAddress    String?
  txSignature  String?
  createdAt    DateTime @default(now())

  @@index([recordCid])
  @@index([actorPubkey])
  @@index([targetPubkey])
  @@index([createdAt])
  @@map("audit_events")
}

model MerkleLeaf {
  id          Int      @id @default(autoincrement())
  ownerPubkey String   @db.VarChar(44)
  recordCid   String
  leafHash    String   @db.VarChar(128)
  leafIndex   Int?
  createdAt   DateTime @default(now())

  @@unique([ownerPubkey, recordCid], name: "merkle_leaves_owner_record_key")
  @@index([ownerPubkey], name: "idx_merkle_owner")
  @@index([recordCid], name: "idx_merkle_record")
  @@map("merkle_leaves")
}

model MerkleRootSnapshot {
  id                Int      @id @default(autoincrement())
  ownerPubkey       String   @db.VarChar(44)
  rootHex           String   @db.VarChar(64)
  leafCount         Int
  anchorTxSignature String?
  anchorPda         String?
  createdAt         DateTime @default(now())

  @@unique([ownerPubkey, rootHex, leafCount], name: "merkle_root_snapshots_owner_root_count_key")
  @@index([ownerPubkey], name: "idx_merkle_root_snapshot_owner")
  @@index([rootHex], name: "idx_merkle_root_snapshot_root")
  @@map("merkle_root_snapshots")
}
